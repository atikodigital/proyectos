GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
DOCAI_PROJECT_ID=
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=
JWT_SECRET=CHANGEME
GASTOS_DB_PASSWORD=
# Login social (Google / Facebook). El backend verifica los tokens con estas llaves.
# GOOGLE_CLIENT_ID = "Client ID" del OAuth Web creado en Google Cloud Console.
# GOOGLE_ANDROID_CLIENT_ID = "Client ID" del OAuth Android (para el APK; lleva la huella SHA-1).
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Facebook Login: reusa la app de Meta del WhatsApp si la activas para Login.
FB_APP_ID=
FB_APP_SECRET=
# Admin de la agencia (consola /admin). 2FA opcional: si seteás el secreto TOTP,
# el login pide código de 6 dígitos. Generalo con: node scripts/admin-2fa-setup.js
GASTOS_ADMIN_USER=atiko
GASTOS_ADMIN_PASSWORD=
GASTOS_ADMIN_TOTP_SECRET=
# Credenciales del dueño para scripts (send-resumen-now.js) — NUNCA hardcodear
PANEL_OWNER_EMAIL=
PANEL_OWNER_PASSWORD=
WHATSAPP_VERIFY_TOKEN=atiko_gastos_2026
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Document AI (opcional; si falta, el OCR usa solo Gemini)
GOOGLE_APPLICATION_CREDENTIALS=
# Seed de la 1a empresa (scripts/seed.js)
SEED_COMPANY=
SEED_OWNER_EMAIL=
SEED_OWNER_PASS=
SEED_OWNER_WA=
SEED_WA_PNID=
SEED_WA_TOKEN=
